DRY_RUN=true
TIMEZONE=Europe/Paris
PORT=8090

# mock | http
TWENTY_MODE=mock
TWENTY_API_URL=http://localhost:3000
TWENTY_API_KEY=

DISCORD_WEBHOOK_URL=

# Product one-liner injected into the default DM template
OUTREACH_PRODUCT_BLURB=We help teams save time on day-to-day organization.

# LIVE uses host `grok` CLI with OAuth subscription (~/.grok/auth.json).
# Do NOT set GROK_API_KEY or XAI_API_KEY — that would bill API credits.
# Authenticate once: `grok login` or `grok login --device-auth`
# GROK_BIN=grok
# GROK_HOME=/home/you/.grok
# PROMPTS_DIR=./prompts
